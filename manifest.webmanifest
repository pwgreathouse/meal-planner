{
  "name": "Meal Planner",
  "short_name": "Meals",
  "description": "Recipes, weekly meal plans, and shopping lists.",
  "start_url": "./#/plan",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#2f6b4f",
